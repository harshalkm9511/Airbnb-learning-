    <% layout("layouts/boilarplate") %>

        <body>
            <div class="showContainer">
                <div class="card col-8 offset-2">
                    <h4 class="card-title">
                        <%= listing.title %>
                    </h4>
                    <br>
                    <img src="<%= listing.image %>" class="card-img-top show-img" alt="listing-image">
                    <div class="card-body">
                        <p class="card-text">
                            <%= listing.description %> <br>
                                &#8377;<%= listing.price.toLocaleString("en-IN") %> <br>
                                    <%= listing.location %> ,
                                        <%= listing.country %>
                        </p>
                    </div>
                    <div class="show-btn ">
                        <div class=" btn">
                            <a href="/listing/<%= listing._id %>/edit" class="btn btn-outline-secondary edit-btn">Edit</a>

                        </div>
                        <div class="btn">
                            <form method="post" action="/listing/<%= listing._id %>?_method=DELETE">
                                <button type="submit" class="btn btn-outline-danger delete-btn">Delete</button>
                            </form>
                        </div>
                    </div>
                    <hr>
                </div>

                <div class="btn-review-form-container col-8 offset-2">

                    <div class="btn-review">
                        <p><b>All Reviews!</b></p>
                        <div>
                            <% for(let rev of listing.reviews ){%>
                                <div class="show-review ">
                                    <p>
                                        <i class="fa-solid fa-circle-user"></i><b>@username</b>
                                        <br>
                                        Comment: <%= rev.comment %> <br>
                                            Rating: <%= rev.rating %>&#9733;<br>
                                    </p>
                                    <form method="post" action="/listing/<%= listing.id %>/reviews/<%= rev.id %>?_method=DELETE"
                                        class="reviewDelete">
                                        <button class="btn btn-dark btn-sm review-delete">Delete</button>
                                    </form>
                                </div>
                                <% }%>
                        </div>
                    </div>


                    <div class=" reviewForm ">
                        <form method="post" action="/listing/<%= listing.id %>/reviews" class="needs-validation" novalidate>
                            <div class="row">
                                <div>
                                    <div class="mb-3 ">
                                        <label for="review" class="form-label">Post Review </label>
                                        <textarea name="reviews[comment]" id="description" style="height: 100px"
                                            class="form-control reviewTextarea" required></textarea>
                                        <div class="invalid-feedback">Write review</div>
                                    </div>
                                    <div class="row">
                                        <div class="mb-3 col-4">
                                            <label for="rating" class="form-label">Rating</label>
                                            <input type="number" name="reviews[rating]" class="form-control reviewInput"
                                                required>
                                            <div class="invalid-feedback">Enter rating </div>
                                        </div>
                                        <button type="submit"
                                            class="btn btn-outline-secondary col-3  createReview post-btn">Post</button>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>

                </div>
            </div>
            </div>
        </body>
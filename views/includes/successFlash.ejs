<%if(success && success.length){%>
    <div class="col-6 mt-4 offset-3 alert alert-success alert-dismissible" role="alert">
        <%= success %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    <%}%>

<%if(error && error.length){%>
    <div class="col-6 mt-4 offset-3 alert alert-danger alert-dismissible " role="alert">
        <%= error %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>

<%}%>